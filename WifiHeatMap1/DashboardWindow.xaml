<Window x:Class="WifiHeatMap1.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Heat Map | Network Analysis Studio"
        Width="1320"
        Height="820"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0C1624"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Primary action buttons -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#167F7D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.6"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary buttons -->
        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#293E52"/>
        </Style>

        <!-- Mapping mode radio buttons -->
        <Style x:Key="ModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C0D1DF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="ModeBorder"
                                Background="#192B3D"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,0">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Grid Width="18"
                                      Height="18"
                                      Margin="0,0,12,0">

                                    <Ellipse Stroke="#7D95A8"
                                             StrokeThickness="1.5"/>

                                    <Ellipse x:Name="SelectedDot"
                                             Width="8"
                                             Height="8"
                                             Fill="#42D8CB"
                                             Visibility="Collapsed"/>
                                </Grid>

                                <ContentPresenter
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="Background"
                                        Value="#173D49"/>

                                <Setter TargetName="ModeBorder"
                                        Property="BorderBrush"
                                        Value="#3CCDBF"/>

                                <Setter TargetName="SelectedDot"
                                        Property="Visibility"
                                        Value="Visible"/>

                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="BorderBrush"
                                        Value="#588293"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text inputs -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#102132"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#476075"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- MAIN APPLICATION GRID -->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- =================================== -->
        <!-- TOP HEADER                          -->
        <!-- =================================== -->

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#101E2F"
                BorderBrush="#304357"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Application logo -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="42"
                            Height="42"
                            Background="#184C55"
                            CornerRadius="10"
                            Margin="0,0,13,0">

                        <TextBlock Text="◉"
                                   Foreground="#62E1D2"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="WiFi Heat Map"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="NETWORK ANALYSIS STUDIO"
                                   FontSize="10"
                                   Foreground="#8DA7BA"/>

                    </StackPanel>

                </StackPanel>


                <!-- TOP-RIGHT CONTROLS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- NEW USER MANUAL BUTTON -->
                    <Button x:Name="BtnUserManual"
                            Content="?  User Manual"
                            Width="145"
                            Height="38"
                            Background="#254157"
                            Foreground="White"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,12,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnUserManual_Click"/>


                    <!-- Workspace status -->
                    <Border Background="#193447"
                            CornerRadius="18"
                            Padding="14,8"
                            VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#42D4AE"
                                     Margin="0,0,9,0"/>

                            <TextBlock Text="Workspace ready"
                                       Foreground="#CBEAE6"
                                       FontSize="12"/>

                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>
        </Border>


        <!-- =================================== -->
        <!-- LEFT SIDEBAR                        -->
        <!-- =================================== -->

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#152335"
                BorderBrush="#304357"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="18,20,18,15">


                        <!-- PROJECT SECTION -->

                        <TextBlock Text="PROJECT"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#90A7B9"
                                   Margin="4,0,0,10"/>

                        <Button x:Name="BtnLoadMap"
                                Content="+  Load Floor Plan"
                                Style="{StaticResource ActionButton}"
                                Click="BtnLoadMap_Click"/>


                        <!-- SCALE DISPLAY -->

                        <Border Background="#1B2D40"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,12,0,24">

                            <StackPanel>

                                <TextBlock Text="CURRENT SCALE"
                                           Foreground="#91A7BA"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="TxtScaleDisplay"
                                           Text="Scale: 35.0 px/m (Default)"
                                           Foreground="#60E0C7"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                            </StackPanel>
                        </Border>


                        <!-- MAPPING MODES -->

                        <TextBlock Text="MAPPING MODE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#90A7B9"
                                   Margin="4,0,0,11"/>

                        <RadioButton x:Name="RadioLiveSurvey"
                                     GroupName="MappingModes"
                                     Content="Live Wi-Fi Survey"
                                     IsChecked="True"
                                     Style="{StaticResource ModeRadioStyle}"
                                     Checked="Mode_Changed"/>

                        <RadioButton x:Name="RadioDrawWalls"
                                     GroupName="MappingModes"
                                     Content="Draw Walls"
                                     Style="{StaticResource ModeRadioStyle}"
                                     Checked="Mode_Changed"/>

                        <RadioButton x:Name="RadioPlaceAp"
                                     GroupName="MappingModes"
                                     Content="Place Virtual Router"
                                     Style="{StaticResource ModeRadioStyle}"
                                     Checked="Mode_Changed"/>

                        <RadioButton x:Name="RadioCalibrate"
                                     GroupName="MappingModes"
                                     Content="Calibrate Distance"
                                     Style="{StaticResource ModeRadioStyle}"
                                     Checked="Mode_Changed"/>


                        <!-- MODE SETTINGS -->

                        <Border Background="#1D2D3F"
                                CornerRadius="9"
                                Padding="12"
                                Margin="0,14,0,18">

                            <Grid>


                                <!-- LIVE SURVEY SETTINGS -->

                                <StackPanel x:Name="PanelSurveyInfo"
                                            Visibility="Visible">

                                    <TextBlock Text="LIVE SURVEY"
                                               Foreground="#67DCCC"
                                               FontSize="11"
                                               FontWeight="Bold"/>

                                    <TextBlock
                                        Text="Select an access point, stand at a location, then click the matching point on the floor plan."
                                        Foreground="#C1D1DE"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Margin="0,8,0,12"/>

                                    <TextBlock Text="ACCESS POINT (BSSID)"
                                               Foreground="#A6C2D0"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>

                                    <!-- WiFi access point selection -->

                                    <ComboBox x:Name="CmbSelectedNetwork"
                                              Height="37"
                                              Background="#F5F8FB"
                                              Foreground="#172638"
                                              BorderBrush="#607487"
                                              VerticalContentAlignment="Center"
                                              ToolTip="Select the access point to measure."/>

                                    <Button x:Name="BtnRefreshNetworks"
                                            Content="Refresh Wi-Fi Networks"
                                            Style="{StaticResource SecondaryButton}"
                                            Height="37"
                                            FontSize="12"
                                            Margin="0,10,0,0"
                                            Click="BtnRefreshNetworks_Click"/>

                                    <TextBlock
                                        Text="Measurements are recorded from the selected access point only."
                                        Foreground="#91A7BA"
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        Margin="0,10,0,0"/>

                                </StackPanel>


                                <!-- WALL DRAWING SETTINGS -->

                                <StackPanel x:Name="PanelWallMaterial"
                                            Visibility="Collapsed">

                                    <TextBlock Text="WALL PROPERTIES"
                                               Foreground="#67DCCC"
                                               FontSize="11"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Wall material"
                                               Foreground="#DBE8F2"
                                               FontSize="12"
                                               Margin="0,10,0,6"/>

                                    <ComboBox x:Name="CmbWallMaterial"
                                              Height="35"
                                              Background="#F5F8FB"
                                              Foreground="#172638"
                                              SelectionChanged="CmbWallMaterial_SelectionChanged">

                                        <ComboBoxItem
                                            Content="Drywall (-3 dB)"
                                            Tag="Drywall"
                                            IsSelected="True"/>

                                        <ComboBoxItem
                                            Content="Glass Window (-2 dB)"
                                            Tag="Glass"/>

                                        <ComboBoxItem
                                            Content="Brick Wall (-6 dB)"
                                            Tag="Brick"/>

                                        <ComboBoxItem
                                            Content="Concrete Wall (-12 dB)"
                                            Tag="Concrete"/>

                                        <ComboBoxItem
                                            Content="Custom Density / Loss..."
                                            Tag="Custom"/>

                                    </ComboBox>


                                    <!-- CUSTOM WALL ATTENUATION -->

                                    <StackPanel x:Name="PanelCustomWallLoss"
                                                Visibility="Collapsed"
                                                Margin="0,12,0,0">

                                        <TextBlock Text="Signal attenuation"
                                                   Foreground="#DBE8F2"
                                                   FontSize="12"
                                                   Margin="0,0,0,6"/>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="TxtCustomDb"
                                                     Text="8.0"
                                                     Height="35"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="dB"
                                                       Foreground="#A6B7C8"
                                                       VerticalAlignment="Center"
                                                       Margin="9,0,0,0"/>

                                        </Grid>

                                    </StackPanel>

                                </StackPanel>

                            </Grid>
                        </Border>


                        <!-- ACTIONS -->

                        <TextBlock Text="ACTIONS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#90A7B9"
                                   Margin="4,0,0,11"/>

                        <Button x:Name="BtnGenerateHeatmap"
                                Content="Generate Heat Map"
                                Style="{StaticResource ActionButton}"
                                Margin="0,0,0,10"
                                Click="BtnGenerateHeatmap_Click"/>

                        <Button x:Name="BtnClear"
                                Content="Clear Canvas"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnClear_Click"/>


                        <!-- STATUS DISPLAY -->

                        <Border BorderBrush="#354A5D"
                                BorderThickness="0,1,0,0"
                                Margin="0,22,0,0"
                                Padding="0,15,0,0">

                            <StackPanel>

                                <TextBlock Text="STATUS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#90A7B9"/>

                                <TextBlock x:Name="TxtStatus"
                                           Text="Ready."
                                           FontSize="12"
                                           Foreground="#7CE6C8"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>


                <!-- LOGOUT BUTTON -->

                <Border Grid.Row="1"
                        Background="#122131"
                        BorderBrush="#304357"
                        BorderThickness="0,1,0,0"
                        Padding="18,13">

                    <Button x:Name="BtnLogout"
                            Content="Sign out"
                            Background="#553740"
                            Foreground="#FFC8CC"
                            Style="{StaticResource ActionButton}"
                            Click="BtnLogout_Click"/>

                </Border>

            </Grid>
        </Border>


        <!-- =================================== -->
        <!-- MAIN FLOOR PLAN WORKSPACE           -->
        <!-- =================================== -->

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="18,17">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- WORKSPACE TITLE -->

            <Grid Grid.Row="0"
                  Margin="3,0,3,14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Floor Plan Workspace"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#F1F7FC"/>

                    <TextBlock
                        Text="Survey coverage, model walls, and visualize signal distribution"
                        FontSize="12"
                        Foreground="#A6B7C8"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <Border Grid.Column="1"
                        Background="#1C3044"
                        CornerRadius="7"
                        Padding="12,7"
                        VerticalAlignment="Center">

                    <TextBlock Text="INDOOR COVERAGE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#91DCCE"/>

                </Border>

            </Grid>


            <!-- MAP VIEWPORT -->

            <Border Grid.Row="1"
                    Background="#172638"
                    BorderBrush="#34495D"
                    BorderThickness="1"
                    CornerRadius="11"
                    ClipToBounds="True">

                <Grid x:Name="MapViewport">


                    <!-- PLACEHOLDER -->

                    <TextBlock x:Name="TxtPlaceholder"
                               Text="Load a floor plan to begin mapping."
                               Foreground="#A4BACB"
                               FontSize="17"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>


                    <!-- FLOOR PLAN SCROLL AREA -->

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">

                        <Grid x:Name="CanvasContainer"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">

                            <!-- Floor plan image -->
                            <Image x:Name="ImgFloorPlan"
                                   Stretch="Uniform"
                                   Panel.ZIndex="0"/>

                            <!-- Heat map overlay -->
                            <Image x:Name="ImgHeatMapOverlay"
                                   Stretch="Fill"
                                   IsHitTestVisible="False"
                                   Panel.ZIndex="1"/>

                            <!-- Interactive canvas -->
                            <Canvas x:Name="HeatMapCanvas"
                                    Background="Transparent"
                                    Panel.ZIndex="2"
                                    MouseLeftButtonDown="HeatMapCanvas_MouseLeftButtonDown"
                                    MouseMove="HeatMapCanvas_MouseMove"
                                    MouseLeftButtonUp="HeatMapCanvas_MouseLeftButtonUp"/>

                        </Grid>
                    </ScrollViewer>


                    <!-- SCALE CALIBRATION DIALOG -->

                    <Border x:Name="ModalScalePrompt"
                            Visibility="Collapsed"
                            Background="#D8000914"
                            Panel.ZIndex="10">

                        <Border Width="365"
                                Padding="23"
                                CornerRadius="12"
                                Background="#1B2D40"
                                BorderBrush="#3BC4B6"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <StackPanel>

                                <TextBlock Text="Calibrate Floor Plan"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>

                                <TextBlock
                                    Text="Enter the real-world length of the line you drew, in meters."
                                    FontSize="12"
                                    Foreground="#B8CBD9"
                                    TextWrapping="Wrap"
                                    Margin="0,10,0,16"/>

                                <TextBlock Text="DISTANCE (METERS)"
                                           Foreground="#A0B5C5"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="TxtMetersInput"
                                         Text="2.0"
                                         Height="38"
                                         Style="{StaticResource InputTextBox}"/>

                                <Grid Margin="0,19,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Cancel"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnCancelScale_Click"/>

                                    <Button Grid.Column="2"
                                            Content="Apply Scale"
                                            Style="{StaticResource ActionButton}"
                                            Click="BtnApplyScale_Click"/>

                                </Grid>

                            </StackPanel>

                        </Border>
                    </Border>

                </Grid>
            </Border>


            <!-- SIGNAL STRENGTH LEGEND -->

            <Grid Grid.Row="2"
                  Margin="4,13,4,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Tip: load a floor plan, select a mode, then click the map."
                    Foreground="#90A7B9"
                    FontSize="11"
                    VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="Weak"
                               Foreground="#A7B8C5"
                               FontSize="11"
                               Margin="0,0,8,0"/>

                    <Border Width="125"
                            Height="9"
                            CornerRadius="5"
                            Margin="0,0,8,0">

                        <Border.Background>
                            <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="1,0">

                                <GradientStop Color="#E46E69"
                                              Offset="0"/>

                                <GradientStop Color="#F6CA68"
                                              Offset="0.5"/>

                                <GradientStop Color="#57CCA5"
                                              Offset="1"/>

                            </LinearGradientBrush>
                        </Border.Background>

                    </Border>

                    <TextBlock Text="Strong"
                               Foreground="#A7B8C5"
                               FontSize="11"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>
