<Window x:Class="WifiHeatMap1.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Heat Map | Network Analysis Studio"
        Width="1320" Height="820" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0C1624" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Background" Value="#14867F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Opacity" Value="0.83"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface"
                                        Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#294156"/>
        </Style>

        <Style x:Key="WarnButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#543640"/>
            <Setter Property="Foreground" Value="#FFD7D9"/>
        </Style>

        <Style x:Key="ToolChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E1EBF2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#85ADC0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#21364B"/>
            <Setter Property="Foreground" Value="#BFD0DD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,5,0"
                                CornerRadius="8,8,0,0">
                            <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#157C77"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="325"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- APPLICATION HEADER -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#111F30"
                BorderBrush="#304357"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#164E56"
                            CornerRadius="10"
                            Width="43"
                            Height="43"
                            Margin="0,0,13,0">
                        <TextBlock Text="◉"
                                   Foreground="#62E1D2"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WiFi Heat Map"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="20"/>
                        <TextBlock
                            Text="NETWORK ANALYSIS STUDIO"
                            Foreground="#9AB1C2"
                            FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BtnUserManual"
                        Grid.Column="1"
                        Content="?  User Manual"
                        Width="150"
                        Height="38"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnUserManual_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- LEFT CONTROLS -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#152335"
                BorderBrush="#304357"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SHARED FLOOR PLAN SETUP -->
                <StackPanel Grid.Row="0" Margin="18,18,18,13">
                    <TextBlock Text="FLOOR PLAN SETUP"
                               Style="{StaticResource SectionTitle}"/>

                    <Button x:Name="BtnLoadMap"
                            Content="+  Load Floor Plan"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnLoadMap_Click"/>

                    <Border Margin="0,10,0,9"
                            Padding="11"
                            CornerRadius="8"
                            Background="#1B3043">
                        <TextBlock x:Name="TxtScaleDisplay"
                                   Text="Scale: 35.0 map units/m (default)"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#78DFCD"/>
                    </Border>

                    <Button x:Name="BtnCalibrate"
                            Content="Calibrate Distance"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnCalibrate_Click"/>

                    <TextBlock
                        Text="Calibration is shared by both workflows."
                        Margin="2,7,0,0"
                        Foreground="#97AEBD"
                        FontSize="11"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <!-- TWO INDEPENDENT WORKFLOWS -->
                <TabControl x:Name="ModeTabs"
                            Grid.Row="1"
                            Margin="13,3,13,0"
                            SelectedIndex="0"
                            Background="#152335"
                            BorderThickness="0"
                            SelectionChanged="ModeTabs_SelectionChanged">

                    <!-- WORKFLOW 1: LIVE SURVEY -->
                    <TabItem x:Name="TabSurvey" Header="LIVE SURVEY">
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Background="#152335">
                            <StackPanel Margin="6,18,6,18">

                                <TextBlock
                                    Text="Real Wi-Fi coverage"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="17"/>

                                <TextBlock
                                    Margin="0,7,0,18"
                                    Text="Measure Wi-Fi strength at real locations. This workspace uses IDW interpolation; walls and virtual routers stay hidden."
                                    Foreground="#B4C8D6"
                                    FontSize="12"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="1  SELECT AN ACCESS POINT"
                                    Style="{StaticResource SectionTitle}"/>

                                <ComboBox x:Name="CmbSelectedNetwork"
                                          Height="36"
                                          Background="White"
                                          Foreground="#13283A"
                                          VerticalContentAlignment="Center"/>

                                <Button x:Name="BtnRefreshNetworks"
                                        Content="Refresh Wi-Fi Networks"
                                        Margin="0,9,0,17"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnRefreshNetworks_Click"/>

                                <TextBlock
                                    Text="2  RECORD MEASUREMENTS"
                                    Style="{StaticResource SectionTitle}"/>

                                <Border Background="#20354A"
                                        Padding="11"
                                        CornerRadius="8"
                                        Margin="0,0,0,13">
                                    <TextBlock
                                        Text="Walk to a location with your laptop, then click that location on the floor plan. Repeat in different rooms."
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="#D5E5EF"/>
                                </Border>

                                <TextBlock x:Name="TxtSurveyCount"
                                           Text="0 measurements (3 needed for IDW)"
                                           Foreground="#75DDCA"
                                           FontSize="12"
                                           Margin="0,0,0,12"/>

                                <Button x:Name="BtnGenerateSurvey"
                                        Content="Generate IDW Heat Map"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnGenerateSurvey_Click"/>

                                <Button x:Name="BtnClearSurvey"
                                        Content="Clear Measurements"
                                        Style="{StaticResource WarnButton}"
                                        Margin="0,9,0,0"
                                        Click="BtnClearSurvey_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- WORKFLOW 2: PREDICTIVE PLAN -->
                    <TabItem x:Name="TabPlanning"
                             Header="PREDICTIVE PLAN">
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Background="#152335">
                            <StackPanel Margin="6,18,6,18">

                                <TextBlock
                                    Text="Router &amp; wall planning"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="17"/>

                                <TextBlock
                                    Margin="0,7,0,18"
                                    Text="Model a virtual router and signal loss through walls. Your live survey measurements are not used in this simulation."
                                    Foreground="#B4C8D6"
                                    FontSize="12"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="1  SELECT A DRAWING TOOL"
                                    Style="{StaticResource SectionTitle}"/>

                                <RadioButton
                                    x:Name="RadioPlaceAp"
                                    Content="Place / move virtual router"
                                    GroupName="PlanningTool"
                                    IsChecked="True"
                                    Style="{StaticResource ToolChoice}"
                                    Checked="PlanTool_Changed"/>

                                <RadioButton
                                    x:Name="RadioDrawWalls"
                                    Content="Draw wall segments"
                                    GroupName="PlanningTool"
                                    Style="{StaticResource ToolChoice}"
                                    Checked="PlanTool_Changed"/>

                                <StackPanel x:Name="PanelWallMaterial"
                                            Visibility="Collapsed"
                                            Margin="0,3,0,14">

                                    <TextBlock
                                        Text="WALL MATERIAL"
                                        Style="{StaticResource SectionTitle}"/>

                                    <ComboBox x:Name="CmbWallMaterial"
                                              Height="36"
                                              Background="White"
                                              Foreground="#13283A"
                                              SelectionChanged="CmbWallMaterial_SelectionChanged">

                                        <ComboBoxItem
                                            Content="Drywall (-3 dB)"
                                            Tag="Drywall"
                                            IsSelected="True"/>
                                        <ComboBoxItem
                                            Content="Glass (-2 dB)"
                                            Tag="Glass"/>
                                        <ComboBoxItem
                                            Content="Brick (-6 dB)"
                                            Tag="Brick"/>
                                        <ComboBoxItem
                                            Content="Concrete (-12 dB)"
                                            Tag="Concrete"/>
                                        <ComboBoxItem
                                            Content="Custom attenuation"
                                            Tag="Custom"/>
                                    </ComboBox>

                                    <StackPanel
                                        x:Name="PanelCustomWallLoss"
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0">

                                        <TextBlock
                                            Text="CUSTOM LOSS (dB)"
                                            Style="{StaticResource SectionTitle}"/>

                                        <TextBox x:Name="TxtCustomDb"
                                                 Height="34"
                                                 Text="8.0"
                                                 Padding="8,4"
                                                 Background="#102132"
                                                 Foreground="White"
                                                 BorderBrush="#476075"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="#20354A"
                                        Padding="11"
                                        CornerRadius="8"
                                        Margin="0,5,0,13">
                                    <TextBlock
                                        Text="Router tool: click to place it. Wall tool: drag along a wall. The predictive map updates automatically."
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="#D5E5EF"/>
                                </Border>

                                <TextBlock x:Name="TxtPlanningCount"
                                           Text="0 walls  |  No virtual router"
                                           Foreground="#75DDCA"
                                           FontSize="12"
                                           Margin="0,0,0,12"/>

                                <Button x:Name="BtnGeneratePrediction"
                                        Content="Generate Prediction"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnGeneratePrediction_Click"/>

                                <Button x:Name="BtnClearPlanning"
                                        Content="Clear Router &amp; Walls"
                                        Style="{StaticResource WarnButton}"
                                        Margin="0,9,0,0"
                                        Click="BtnClearPlanning_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- FIXED STATUS + LOGOUT -->
                <Border Grid.Row="2"
                        BorderBrush="#304357"
                        BorderThickness="0,1,0,0"
                        Padding="17,12">
                    <StackPanel>
                        <TextBlock Text="STATUS"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock x:Name="TxtStatus"
                                   Text="Load a floor plan to begin."
                                   Foreground="#83E3CE"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Button x:Name="BtnLogout"
                                Content="Sign out"
                                Style="{StaticResource SecondaryButton}"
                                Height="34"
                                Click="BtnLogout_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN MAP WORKSPACE -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="3,0,3,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TxtWorkspaceTitle"
                               Text="Live Wi-Fi Survey"
                               FontSize="21"
                               Foreground="White"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="TxtWorkspaceSubtitle"
                               Text="Actual measurements and IDW interpolation"
                               Foreground="#A6B7C8"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#20374B"
                        CornerRadius="8"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtModeBadge"
                               Text="MEASURED"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#7BE1CE"/>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="#182A3D"
                    BorderBrush="#34495D"
                    BorderThickness="1"
                    CornerRadius="11"
                    ClipToBounds="True">
                <Grid x:Name="MapViewport">

                    <TextBlock x:Name="TxtPlaceholder"
                               Text="Load a floor plan to begin."
                               FontSize="17"
                               Foreground="#A4BACB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">

                        <Grid x:Name="CanvasContainer"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">

                            <Image x:Name="ImgFloorPlan"
                                   Stretch="Fill"
                                   IsHitTestVisible="False"
                                   Panel.ZIndex="0"/>

                            <Image x:Name="ImgHeatMapOverlay"
                                   Stretch="Fill"
                                   IsHitTestVisible="False"
                                   Panel.ZIndex="1"/>

                            <!-- LIVE SURVEY CANVAS -->
                            <Canvas x:Name="SurveyCanvas"
                                    Background="Transparent"
                                    Panel.ZIndex="2"
                                    MouseLeftButtonDown="SurveyCanvas_MouseLeftButtonDown"
                                    MouseMove="MapCanvas_MouseMove"
                                    MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"/>

                            <!-- PREDICTIVE PLANNING CANVAS -->
                            <Canvas x:Name="PlanningCanvas"
                                    Visibility="Collapsed"
                                    Background="Transparent"
                                    Panel.ZIndex="3"
                                    MouseLeftButtonDown="PlanningCanvas_MouseLeftButtonDown"
                                    MouseMove="MapCanvas_MouseMove"
                                    MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- SHARED CALIBRATION DIALOG -->
                    <Border x:Name="ModalScalePrompt"
                            Visibility="Collapsed"
                            Background="#D8000914"
                            Panel.ZIndex="10">
                        <Border Width="355"
                                Padding="23"
                                Background="#1B2D40"
                                CornerRadius="12"
                                BorderBrush="#3BC4B6"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBlock
                                    Text="Calibrate Floor Plan"
                                    Foreground="White"
                                    FontSize="19"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Margin="0,10,0,15"
                                    Text="Enter the real-world distance represented by the line you drew."
                                    Foreground="#C2D2DF"
                                    FontSize="12"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="DISTANCE IN METERS"
                                    FontSize="10"
                                    Foreground="#9BB8C8"
                                    Margin="0,0,0,7"/>

                                <TextBox x:Name="TxtMetersInput"
                                         Text="2.0"
                                         Height="37"
                                         Padding="9,6"
                                         Foreground="White"
                                         Background="#102132"
                                         BorderBrush="#476075"/>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="9"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Cancel"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BtnCancelScale_Click"/>

                                    <Button Grid.Column="2"
                                            Content="Apply Scale"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BtnApplyScale_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       x:Name="TxtMapHint"
                       Text="Click the floor plan to record a measurement at your current location."
                       Foreground="#9AB1C2"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="4,12,4,0"/>
        </Grid>
    </Grid>
</Window>
