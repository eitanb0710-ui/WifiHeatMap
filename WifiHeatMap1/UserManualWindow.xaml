<Window x:Class="WifiHeatMap1.UserManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Heat Map | User Manual"
        Width="900" Height="700" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0C1624" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#72DFCC"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4E1EA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1B3044"/>
            <Setter Property="BorderBrush" Value="#365066"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>
        <!-- Modern dark navigation tabs; no default white buttons. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#D4E1EA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1A3043"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#365066" BorderThickness="1">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#167C77"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#52D7C3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111F30" Padding="26,15"
                BorderBrush="#304357" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="WiFi Heat Map | User Manual"
                           Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="MEASURE  •  SIMULATE  •  OPTIMIZE  •  EXPORT"
                           Foreground="#72DFCC" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="18" Padding="10" Background="#081527"
                BorderBrush="#2D4459" BorderThickness="1" CornerRadius="10">
            <TabControl Background="Transparent" BorderThickness="0">

                <TabItem Header="Quick Start">
                    <ScrollViewer Background="#081527" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,19,18,15">
                            <TextBlock Text="Getting started" Style="{StaticResource Heading}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="1. Load a floor plan" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Click Load Floor Plan and choose a PNG, JPG, JPEG or BMP. The same image is shared by Live Survey and Predictive Plan."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="2. Calibrate distance" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Click Calibrate Distance. Drag along a known length and enter its real distance in meters. Calibration is shared by both workspaces."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="3. Choose a workspace" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Live Survey records real signal samples and generates IDW interpolation. Predictive Plan models a virtual router and wall attenuation. Switching tabs keeps their data separate."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="4. Save or export" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Save Project creates an editable .wifimap file. Export PDF Report creates a shareable, read-only report with both floor-plan views and technical details."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Live Survey">
                    <ScrollViewer Background="#081527" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,19,18,15">
                            <TextBlock Text="Measure actual WiFi signal" Style="{StaticResource Heading}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Select the access point" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Click Refresh Wi-Fi Networks and select an SSID/BSSID. A BSSID identifies one access-point radio. Measurements from different BSSIDs are not combined."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Record samples" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Stand at a real location with your laptop and click the matching location on the floor plan. Each sample records the scanned RSSI in dBm and shows a numbered blue marker."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Generate the IDW map" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Take at least three measurements at different places. IDW estimates RSSI between measurements. It is not a method of locating the physical router."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Clear Measurements" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Deletes only survey samples. The virtual router and drawn walls in Predictive Plan remain untouched."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Predictive Plan">
                    <ScrollViewer Background="#081527" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,19,18,15">
                            <TextBlock Text="Simulate router coverage" Style="{StaticResource Heading}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Place or move a router" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Select Place / move virtual router and click the image. Click elsewhere to change its location. The prediction uses your calibrated scale and wall layout."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Draw walls" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Choose Draw wall segments, select a material, and drag along a wall. Default losses are glass 2 dB, drywall 3 dB, brick 6 dB, concrete 12 dB, or your custom value."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Generate Prediction" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="The map is an estimated RSSI field from a simplified distance-and-wall-loss model. It does not use Live Survey samples."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Clear Router &amp; Walls" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Deletes the predictive router and walls without removing Live Survey measurements."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Save &amp; Export">
                    <ScrollViewer Background="#081527" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,19,18,15">
                            <TextBlock Text="Editable projects and PDF reports" Style="{StaticResource Heading}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Save / Open / Save As" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="A .wifimap file stores the original floor-plan image, survey BSSID and RSSI samples, calibration, walls, materials and virtual router. Open Project restores those editable objects."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Export PDF Report" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Click Export PDF Report in the PROJECT area and choose a .pdf filename. The report contains an overview, the measured map and sample table, predictive map and wall table, and router optimization with methodology. You can open the PDF in Google Drive, a browser or a PDF viewer."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Your project is not changed" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Export does not replace your .wifimap file and does not move the virtual router. The report is created from a snapshot of both workspaces, even if one tab is currently hidden."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Sharing and privacy" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Reports may contain a building layout, network SSID/BSSID and measurement positions. Inspect the PDF before sharing it publicly."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Optimization">
                    <ScrollViewer Background="#081527" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,19,18,15">
                            <TextBlock Text="Find a better simulated router position" Style="{StaticResource Heading}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Run the optimizer" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="In Predictive Plan, calibrate distance, draw walls and enter a coverage target (e.g. -67 dBm). Click Find Best Router Position. The green BEST marker is a recommendation only; Apply Suggested Position moves the router."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Optimization in PDF reports" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="When a virtual router exists, exporting a PDF recalculates the current and best grid-candidate coverage from the same captured project data. It does not modify the router or your project."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Limitations" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Candidate and receiving points are sampled on the entire rectangular image. The program does not yet distinguish rooms, outdoor areas, interference, furniture or mounting constraints. This is a modeled estimate, not guaranteed real-world coverage."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Common problems" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="If no WiFi networks appear, check the adapter and Windows location permission. If your heat map is empty, Live Survey needs three samples and Predictive Plan needs a router. The optimizer should be run after calibration."
                                               Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="2" Background="#111F30" BorderBrush="#304357"
                BorderThickness="0,1,0,0">
            <TextBlock Text="WiFi Heat Map  |  User Manual  |  PDF Report Edition"
                       Foreground="#9CB1C1" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
