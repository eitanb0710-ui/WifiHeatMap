<Window x:Class="WifiHeatMap1.UserManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Heat Map | User Manual"
        Width="850" Height="670"
        MinWidth="660" MinHeight="490"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0C1624"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#72DFCC"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4E1EA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>

        <Style x:Key="HelpCard" TargetType="Border">
            <Setter Property="Background" Value="#1B3044"/>
            <Setter Property="BorderBrush" Value="#365066"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#111F30"
                Padding="26,15"
                BorderBrush="#304357"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock
                    Text="WiFi Heat Map | User Manual"
                    Foreground="White"
                    FontSize="22"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="TWO WORKFLOWS, ONE FLOOR PLAN"
                    Foreground="#72DFCC"
                    FontSize="11"
                    Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- MANUAL -->
        <TabControl Grid.Row="1"
                    Margin="20"
                    Background="#0C1624">

            <!-- QUICK START -->
            <TabItem Header="Quick Start">
                <ScrollViewer
                    Background="#0C1624"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,19,18,15">

                        <TextBlock
                            Text="Getting started"
                            Style="{StaticResource SectionHeading}"/>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Step 1 — Load a floor plan"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Click Load Floor Plan. Choose a PNG, JPG, JPEG, or BMP image. The same image is used by both workflows."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Step 2 — Calibrate"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Click Calibrate Distance, draw across a known length, and enter the distance in meters. Calibration is shared across both workflows."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Step 3 — Choose a workflow"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="LIVE SURVEY measures actual RSSI and builds an IDW map. PREDICTIVE PLAN simulates a virtual router and walls. Switch using the two tabs in the left sidebar."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Switching safely"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Switching tabs keeps both sets of data. Each tab has its own Clear button. Loading a new floor plan erases both sets of data after confirmation."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- LIVE SURVEY -->
            <TabItem Header="Live Survey">
                <ScrollViewer
                    Background="#0C1624"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,19,18,15">

                        <TextBlock
                            Text="Measure real Wi-Fi coverage"
                            Style="{StaticResource SectionHeading}"/>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Choose an access point"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Click Refresh Wi-Fi Networks and choose the desired SSID/BSSID. SSID is the network name; BSSID identifies an individual access-point radio. One survey uses one BSSID."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Collect signal samples"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Stand with your laptop at a real location and click that position on the floor plan. Each click records an RSSI value in dBm. More negative values usually indicate weaker reception."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Generate the IDW heat map"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Record at least three samples at different locations. The map updates automatically and can be refreshed with Generate IDW Heat Map. IDW estimates signal between sampled positions."
                                    Style="{StaticResource Description}"/>

                                <TextBlock
                                    Margin="0,9,0,0"
                                    Foreground="#F1CD91"
                                    TextWrapping="Wrap"
                                    Text="A sample marker shows where you measured the signal, not the physical router location. IDW cannot identify the router's position."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Clear only survey points"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Click Clear Measurements to start another survey. Walls and virtual router positions from the Predictive Plan remain intact."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PREDICTIVE PLANNING -->
            <TabItem Header="Predictive Plan">
                <ScrollViewer
                    Background="#0C1624"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,19,18,15">

                        <TextBlock
                            Text="Plan Wi-Fi coverage"
                            Style="{StaticResource SectionHeading}"/>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Place or move a virtual router"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Select Place / move virtual router and click the floor plan. Clicking another location moves it. The program calculates estimated coverage using distance and walls."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Draw walls"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Select Draw wall segments, choose a material, and drag a line along a wall. Default model loss: glass 2 dB, drywall 3 dB, brick 6 dB, concrete 12 dB, or a custom value."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Generate the prediction"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="After placing a router, the prediction updates automatically when the router moves or a wall is added. Use Generate Prediction to refresh it manually."
                                    Style="{StaticResource Description}"/>

                                <TextBlock
                                    Margin="0,9,0,0"
                                    Foreground="#F1CD91"
                                    TextWrapping="Wrap"
                                    Text="This view is a simulation, not a measurement. The wall losses are approximations and should be validated with real readings."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Clear only router and walls"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Click Clear Router &amp; Walls. Live Survey points are preserved."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- CALIBRATION + HELP -->
            <TabItem Header="Calibration &amp; Help">
                <ScrollViewer
                    Background="#0C1624"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,19,18,15">

                        <TextBlock
                            Text="Calibration and troubleshooting"
                            Style="{StaticResource SectionHeading}"/>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Calibrate Distance"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="In either workflow, click Calibrate Distance. Drag from one end of a known distance to the other and enter its real length in meters. For example, a line of 200 map units over 5 meters gives 40 units/m. The temporary line disappears after Apply or Cancel."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="No Wi-Fi networks appear"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Make sure the Wi-Fi adapter is enabled. Check Windows location permissions, then click Refresh Wi-Fi Networks again. The application will not insert fictional readings."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Why is my heat map empty?"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Live Survey needs three or more samples from one access point. Predictive Plan needs a virtual router. Walls are optional."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCard}">
                            <StackPanel>
                                <TextBlock
                                    Text="Saving projects"
                                    Style="{StaticResource SectionHeading}"/>

                                <TextBlock
                                    Text="Saving and reopening full projects is planned but not yet implemented. Closing the app will discard the unsaved workspace."
                                    Style="{StaticResource Description}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="#111F30"
                BorderBrush="#304357"
                BorderThickness="0,1,0,0">
            <TextBlock
                Text="WiFi Heat Map | Built-in User Manual | Two-Workflow Edition"
                Foreground="#9CB1C1"
                FontSize="11"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>
