<Window x:Class="WifiHeatMap1.UserManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Heat Map | User Manual"
        Width="880" Height="690"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0C1624"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="Heading"
               TargetType="TextBlock">

            <Setter Property="Foreground" Value="#72DFCC"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Body"
               TargetType="TextBlock">

            <Setter Property="Foreground" Value="#D4E1EA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>

        <Style x:Key="Card"
               TargetType="Border">

            <Setter Property="Background" Value="#1B3044"/>
            <Setter Property="BorderBrush" Value="#365066"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>

        <!-- DARK, ROUNDED MANUAL TABS -->

        <Style TargetType="TabItem">

            <Setter Property="Foreground" Value="#D4E1EA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1A3043"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="14,11"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">

                        <Border x:Name="TabSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#365066"
                                BorderThickness="1">

                            <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="TabSurface"
                                        Property="Background"
                                        Value="#167C77"/>

                                <Setter TargetName="TabSurface"
                                        Property="BorderBrush"
                                        Value="#52D7C3"/>

                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TabSurface"
                                        Property="Opacity"
                                        Value="0.83"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#111F30"
                Padding="26,15"
                BorderBrush="#304357"
                BorderThickness="0,0,0,1">

            <StackPanel>

                <TextBlock
                    Text="WiFi Heat Map | User Manual"
                    Foreground="White"
                    FontSize="22"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="SAVE PROJECTS • MEASURE • SIMULATE • OPTIMIZE"
                    Foreground="#72DFCC"
                    FontSize="11"
                    Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- MANUAL CONTENT -->

        <Border Grid.Row="1"
                Margin="18"
                Padding="10"
                Background="#081527"
                BorderBrush="#2D4459"
                BorderThickness="1"
                CornerRadius="10">

            <TabControl Background="Transparent"
                        BorderThickness="0">

                <!-- QUICK START -->

                <TabItem Header="Quick Start">

                    <ScrollViewer
                        Background="#081527"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="12,19,18,15">

                            <TextBlock
                                Text="Getting started"
                                Style="{StaticResource Heading}"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="1. Load a floor plan"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Click Load Floor Plan and choose PNG, JPG, JPEG, or BMP. The same image is used by both workflows."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="2. Calibrate the image"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Click Calibrate Distance, drag across a known length, and enter meters. Calibration is shared between survey and prediction."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="3. Choose your workspace"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="LIVE SURVEY collects real RSSI measurements. PREDICTIVE PLAN models a virtual router and walls. Switching tabs does not erase either workspace."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="4. Save your work"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Click Save Project. Choose a .wifimap filename. The project embeds your floor-plan image, measurements, wall materials, router, and scale. Use Open Project later to continue."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- LIVE SURVEY -->

                <TabItem Header="Live Survey">

                    <ScrollViewer
                        Background="#081527"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="12,19,18,15">

                            <TextBlock
                                Text="Record real Wi-Fi coverage"
                                Style="{StaticResource Heading}"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Select SSID / BSSID"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Refresh Wi-Fi Networks, then select an access point. BSSID identifies a specific radio. One survey can contain samples from only one BSSID."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Measure at the correct position"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Move your laptop physically to a location and click the corresponding map position. The recorded RSSI in dBm is an actual scan result, not a simulated signal."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Interpolate using IDW"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Collect at least three well-separated measurements. IDW estimates signal strength between them. Measurements do not tell the app where the real router is located."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PREDICTIVE PLAN -->

                <TabItem Header="Predictive Plan">

                    <ScrollViewer
                        Background="#081527"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="12,19,18,15">

                            <TextBlock
                                Text="Simulate router and walls"
                                Style="{StaticResource Heading}"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Place a virtual router"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Choose Place / move virtual router and click the image. Clicking elsewhere moves the router; the prediction updates automatically."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Draw walls"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Choose Draw wall segments, select Drywall, Glass, Brick, Concrete, or Custom attenuation, then drag a line. Wall loss is included only in Predictive Plan."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Understand the simulation"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="The predictive heat map combines distance-dependent path loss with walls crossed by the signal. These are simplified assumptions, not measured coverage."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- SAVE AND OPTIMIZE -->

                <TabItem Header="Save &amp; Optimize">

                    <ScrollViewer
                        Background="#081527"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="12,19,18,15">

                            <TextBlock
                                Text="Projects and router optimization"
                                Style="{StaticResource Heading}"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Save / Open / Save As"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Save Project updates your current file; Save As creates a separate copy; Open Project restores your work. A .wifimap includes the original image, both workspaces, network identity, and calibration. Unsaved changes are marked with an asterisk."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Find Best Router Position"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Open Predictive Plan, draw your walls, calibrate the scale, and enter an RSSI coverage target such as -67 dBm. Click Find Best Router Position. The green BEST marker shows a recommendation; click Apply Suggested Position to move the router."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="What the percentages mean"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="The optimizer scores a grid of locations over the entire rectangular image. Covered means predicted RSSI meets the target. It is not a measurement or guaranteed performance, and it may suggest an inaccessible point outside actual rooms."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Important limitations"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="One virtual router is optimized at a time. Only the modeled RSSI threshold is considered; interference, channel use, installation constraints, and real floor boundaries are not yet evaluated."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- HELP -->

                <TabItem Header="Help">

                    <ScrollViewer
                        Background="#081527"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="12,19,18,15">

                            <TextBlock
                                Text="Troubleshooting"
                                Style="{StaticResource Heading}"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="No networks appear"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Enable your Wi-Fi adapter, check Windows location permissions, and refresh the access-point list. A previously saved BSSID must still be detectable to record a new measurement."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="No heat map"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Live Survey needs at least three samples. Predictive Plan needs a router. Calibration is strongly recommended for meaningful distances."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock
                                        Text="Clearing and loading"
                                        Style="{StaticResource Heading}"/>

                                    <TextBlock
                                        Text="Clear Measurements affects only Live Survey. Clear Router &amp; Walls affects only Predictive Plan. Loading a different image starts a fresh project; opening a .wifimap restores a previously saved project."
                                        Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- FOOTER -->

        <Border Grid.Row="2"
                Background="#111F30"
                BorderBrush="#304357"
                BorderThickness="0,1,0,0">

            <TextBlock
                Text="WiFi Heat Map | User Manual v1.3 | Save + Optimization"
                Foreground="#9CB1C1"
                FontSize="11"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>
